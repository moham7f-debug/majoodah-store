{# الهيدر: الشعار، البحث، أيقونات (واتساب/السلة/القائمة)، شريط التصنيفات #}
{% set wa = theme.settings.get('whatsapp_number', '966500000000') %}
<header class="header" id="header">
  <div class="container header__inner">
    <a class="brand" href="{{ link.home | default('/') }}" aria-label="{{ store.name | default('متجر مجودة') }} — الصفحة الرئيسية">
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 40 40" width="40" height="40"><rect width="40" height="40" rx="11" fill="url(#bg)"/><path d="M11 27V14l9 6 9-6v13" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/><defs><linearGradient id="bg" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#10917b"/><stop offset="1" stop-color="#0b6a5b"/></linearGradient></defs></svg>
      </span>
      <span class="brand__text">
        <strong>{{ store.name | default('متجر مجودة') }}</strong>
        <small>للمنتجات التعليمية</small>
      </span>
    </a>

    <form class="search" role="search" action="{{ link.search | default('/search') }}" onsubmit="return false;">
      <label for="search-input" class="sr-only">ابحث عن منتج</label>
      <svg class="search__icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><line x1="21" y1="21" x2="16.5" y2="16.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      <input id="search-input" name="s" type="search" placeholder="ابحث عن سجل، ملف إنجاز، لوحة..." autocomplete="off" />
    </form>

    <div class="header__actions">
      <a class="icon-btn" href="https://wa.me/{{ wa }}" aria-label="تواصل عبر واتساب" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15l-1 3.6 3.7-1A10 10 0 1 0 12 2Zm0 18a8 8 0 0 1-4.1-1.1l-.3-.2-2.2.6.6-2.1-.2-.3A8 8 0 1 1 12 20Zm4.4-5.6c-.2-.1-1.4-.7-1.6-.8s-.4-.1-.5.1-.6.8-.8 1-.3.2-.5.1a6.5 6.5 0 0 1-3.2-2.8c-.2-.4.2-.4.6-1.2.1-.2 0-.3 0-.4s-.5-1.3-.7-1.7-.4-.4-.5-.4h-.5a.9.9 0 0 0-.7.3 2.8 2.8 0 0 0-.9 2.1 4.9 4.9 0 0 0 1 2.6 11 11 0 0 0 4.3 3.8c1.6.6 1.9.5 2.3.5a2.4 2.4 0 0 0 1.6-1.1 2 2 0 0 0 .1-1.1c0-.1-.2-.2-.4-.3Z"/></svg>
      </a>
      <button class="icon-btn cart-btn" id="cartBtn" aria-label="عربة التسوق">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M3 4h2l2 12h11l2-8H6"/><circle cx="9" cy="20" r="1.4" fill="currentColor"/><circle cx="18" cy="20" r="1.4" fill="currentColor"/></svg>
        <span class="cart-count" id="cartCount" aria-live="polite">0</span>
      </button>
      <button class="icon-btn menu-toggle" id="menuToggle" aria-label="القائمة" aria-expanded="false" aria-controls="primary-nav">
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>

  <nav class="nav" id="primary-nav" aria-label="التصنيفات الرئيسية">
    <div class="container nav__inner">
      <a href="#cat-teacher">👩‍🏫 معلم / معلمة</a>
      <a href="#cat-activity">🎯 رائد نشاط</a>
      <a href="#cat-counselor">🧭 موجه طلابي</a>
      <a href="#cat-principal">🏫 مدير مدرسة</a>
      <a href="#cat-agent">📋 وكيل مدرسة</a>
      <a href="#faq">الأسئلة الشائعة</a>
    </div>
  </nav>
</header>
